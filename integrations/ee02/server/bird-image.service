[Unit]
Description=Bird frame image server
After=network-online.target
Wants=network-online.target

[Service]
User=birdframe
Group=birdframe
ExecStart=/opt/bird-renderer/venv/bin/python /opt/bird-renderer/service.py
Restart=on-failure
WorkingDirectory=/opt/bird-renderer
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bird-renderer
PrivateTmp=true

[Install]
WantedBy=multi-user.target
